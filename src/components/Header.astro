---
const home = Astro.url.pathname === "/";
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="David Glover, home">
    david glover<span>.</span>
  </a>
  <nav aria-label="Main navigation">
    <a href={home ? "#work" : "/#work"}>Work</a>
    <a href={home ? "#about" : "/#about"}>About</a>
    <a class="nav-contact" href={home ? "#contact" : "/#contact"}>
      Let’s talk <span aria-hidden="true">↗</span>
    </a>
  </nav>
</header>
