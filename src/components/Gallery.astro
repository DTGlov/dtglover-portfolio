---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface GalleryItem {
  src: ImageMetadata;
  alt: string;
  title: string;
  detail: string;
}

interface Props {
  label: string;
  title: string;
  items: GalleryItem[];
}

const { label, title, items } = Astro.props;
---

<section class="screen-gallery" aria-label={title}>
  <div class="gallery-heading">
    <div>
      <p class="eyebrow">{label}</p>
      <h2>{title}</h2>
    </div>
    <p>
      Explore the screens <span aria-hidden="true">↗</span>
    </p>
  </div>
  <div
    class="screen-rail"
    tabindex="0"
    aria-label={`${title}. Scroll horizontally to see more screens.`}
  >
    {items.map((item) => (
      <figure class="screen-card">
        <div class="screen-frame">
          <Image
            src={item.src}
            alt={item.alt}
            width={500}
            format="webp"
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption>
          <span>{item.title}</span>
          <small>{item.detail}</small>
        </figcaption>
      </figure>
    ))}
  </div>
</section>
