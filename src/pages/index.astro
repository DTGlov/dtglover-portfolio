---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---

<Layout>
  <section class="hero" aria-labelledby="intro-heading">
    <div class="hero-copy">
      <p class="eyebrow intro-label">
        <span class="availability-dot"></span> MOBILE PRODUCT ENGINEER · ACCRA,
        GHANA
      </p>
      <h1 id="intro-heading">
        Thoughtful apps.
        <br />
        Real-world impact.
        <br />
        <span class="blue">A little personality.</span>
      </h1>
      <p class="hero-description">
        Hi, I’m David. I build mobile experiences at{" "}
        <a href="https://hubtel.com">Hubtel</a> and bring my own ideas to life
        with AI agents. From the first architectural decision to the details you
        actually feel.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="#work">
          Explore my work <Icon />
        </a>
        <a class="text-link" href="#about">
          A little about me <Icon name="external" />
        </a>
      </div>
      <p class="open-note">
        Open to remote opportunities & thoughtful collaborations
      </p>
    </div>
    <div class="hero-art">
      <div class="avatar-frame">
        <span class="corner-note">THE PERSON BEHIND THE PIXELS</span>
        <div class="avatar-space">
          <img
            src="/images/pixel-character.png"
            alt="A friendly pixel-art developer with a laptop, representing David"
            width="1024"
            height="1024"
            fetchpriority="high"
          />
        </div>
        <div class="character-caption">
          <span>David, in a few pixels.</span>
          <span aria-hidden="true">✳</span>
        </div>
      </div>
      <div class="art-footnote">
        <span class="tiny-cross" aria-hidden="true">
          +
        </span>{" "}
        Curious by nature. Builder by choice.
      </div>
    </div>
  </section>
  <div class="practice-strip">
    <span>PRODUCTION EXPERIENCE. PRODUCT CURIOSITY.</span>
    <div>
      <span>Flutter & Dart</span>
      <span>Web & native iOS</span>
      <span>AI-assisted development</span>
    </div>
  </div>
  <section
    id="work"
    class="section selected-work"
    aria-labelledby="work-heading"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / SELECTED WORK</p>
        <h2 id="work-heading">Built with intention.</h2>
      </div>
      <p>
        Professional work and a personal project.
        <br />
        Two different ways of making things useful.
      </p>
    </div>
    <div class="project-grid">
      <a class="project-card" href="/work/hubtel/">
        <div class="project-cover hubtel-cover">
          <div class="cover-top">
            <img
              class="brand-logo hubtel-brand"
              src="/images/brands/hubtel.png"
              alt="Hubtel"
              width="303"
              height="192"
              loading="lazy"
            />
            <span class="cover-status">PROFESSIONAL WORK</span>
          </div>
          <div class="hubtel-cover-title">
            Everyday purchases.
            <br />
            <span>Smaller steps.</span>
          </div>
          <div class="payment-story" aria-hidden="true">
            <div>
              <span>01</span> Purchase
            </div>
            <i></i>
            <div>
              <span>02</span> Pay back
            </div>
            <i></i>
            <div>
              <span>03</span> Keep track
            </div>
          </div>
          <div class="cover-bottom">
            <span>PAY SMALL SMALL</span>
            <span>Flutter / Mobile</span>
          </div>
        </div>
        <div class="project-meta">
          <span>HUBTEL · MOBILE ENGINEERING</span>
          <Icon name="external" />
        </div>
        <h3>Making everyday credit feel simpler.</h3>
        <p>
          The mobile implementation of Pay Small Small, alongside authentication
          and account experiences in the Hubtel app.
        </p>
        <div class="tags">
          <span>Flutter</span>
          <span>Fintech</span>
          <span>Production</span>
        </div>
      </a>
      <a class="project-card" href="/work/sika/">
        <div class="project-cover sika-cover">
          <div class="cover-top">
            <span class="sika-brand">
              <img
                src="/images/brands/sika.svg"
                alt=""
                width="48"
                height="48"
                loading="lazy"
              />
              <span>Sika</span>
            </span>
            <span class="cover-status">PERSONAL PRODUCT</span>
          </div>
          <div class="sika-cover-title">
            A little clarity.
            <br />A little more <em>possibility.</em>
          </div>
          <div class="sika-chips" aria-hidden="true">
            <span>Today’s spending</span>
            <span>Tomorrow’s plans</span>
            <span>Should I buy it?</span>
          </div>
          <div class="cover-bottom">
            <span>YOUR MONEY, WITH A LITTLE MORE INTENTION</span>
            <span>Web + iOS</span>
          </div>
        </div>
        <div class="project-meta">
          <span>SIKA · PRODUCT & AI-ASSISTED DEVELOPMENT</span>
          <Icon name="external" />
        </div>
        <h3>A calmer relationship with money.</h3>
        <p>
          A personal finance app built with AI agents. Spending, goals,
          recurring commitments, and decisions—all connected.
        </p>
        <div class="tags">
          <span>Next.js</span>
          <span>SwiftUI</span>
          <span>Supabase</span>
          <span>AI</span>
        </div>
      </a>
    </div>
  </section>
  <section
    id="about"
    class="section about-section"
    aria-labelledby="about-heading"
  >
    <div>
      <p class="eyebrow">02 / A LITTLE ABOUT ME</p>
      <h2 id="about-heading">
        An engineer’s mindset.
        <br />A builder’s curiosity.
      </h2>
      <div class="about-note">
        <span aria-hidden="true">↳</span>
        <p>
          From studying physics
          <br />
          to building products people use.
        </p>
      </div>
    </div>
    <div class="about-copy">
      <p>
        I’m David Tawiah Glover, a Mobile Product Engineer based in Accra. At
        Hubtel, I work on the experiences people use to access their accounts,
        manage payments, and use Pay Small Small.
      </p>
      <p>
        My path started in frontend and full-stack development. Today, Flutter
        is at the heart of my professional work, while my own projects take me
        into web, native iOS, and new ways of building with AI.
      </p>
      <p>
        I like understanding how things fit together—and making the result feel
        simple for the person on the other side of the screen.
      </p>
      <a class="text-link" href="https://www.linkedin.com/in/dtglover/">
        More of my story on LinkedIn <Icon name="external" />
      </a>
    </div>
  </section>
  <section class="section process-section" aria-labelledby="process-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">03 / HOW I BUILD</p>
        <h2 id="process-heading">
          Human judgment.
          <br />
          <span class="blue">AI in the workflow.</span>
        </h2>
      </div>
      <p>
        I work with Codex, ChatGPT, and Cursor to take ideas from architecture
        to implementation. The decisions—and responsibility—stay with me.
      </p>
    </div>
    <div class="process-grid">
      <article>
        <span class="step-number">01</span>
        <h3>Understand the product.</h3>
        <p>
          Start with the person using it, the problem worth solving, and the
          rules the product needs to respect.
        </p>
      </article>
      <article>
        <span class="step-number">02</span>
        <h3>Build with agents.</h3>
        <p>
          Set the architecture, break work into focused pieces, and direct
          agents through implementation.
        </p>
      </article>
      <article>
        <span class="step-number">03</span>
        <h3>Question the result.</h3>
        <p>
          Review the behaviour, revisit assumptions, and refine the details.
          Working code is the beginning.
        </p>
      </article>
    </div>
    <a class="text-link" href="/work/sika/#agent-workflow">
      See how this shaped Sika <Icon name="external" />
    </a>
  </section>
  <section
    class="section experience-section"
    aria-labelledby="experience-heading"
  >
    <div>
      <p class="eyebrow">04 / ALONG THE WAY</p>
      <h2 id="experience-heading">
        A few chapters
        <br />
        of the journey.
      </h2>
    </div>
    <div class="experience-list">
      <article>
        <div>
          <h3>Hubtel</h3>
          <p>Mobile Product Engineer</p>
        </div>
        <span>2022 — Present</span>
      </article>
      <article>
        <div>
          <h3>TheSidneySpace</h3>
          <p>Co-founder · Head of Growth</p>
        </div>
        <span>2025 — Present</span>
      </article>
      <article>
        <div>
          <h3>Enyata</h3>
          <p>Full Stack Intern → Frontend Engineer</p>
        </div>
        <span>2021 — 2022</span>
      </article>
      <article>
        <div>
          <h3>Independent</h3>
          <p>Freelance Full Stack Developer</p>
        </div>
        <span>2020 — 2022</span>
      </article>
    </div>
  </section>
</Layout>
